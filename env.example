# Copy to .env.local for local development.
# On Vercel add the same names under Project → Settings → Environment Variables.

# ── Site ────────────────────────────────────────────────────────────
# Public address of the site, no trailing slash. Used for canonical URLs,
# sitemap and social previews. On Vercel it falls back to the production
# domain automatically, but set it once you attach your own domain.
NEXT_PUBLIC_SITE_URL=https://example.uz

# Shown in the footer and in the legal pages (who runs the service).
NEXT_PUBLIC_COMPANY_NAME=Your Company LLC
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.uz

# Optional. Telegram channel or bot, e.g. https://t.me/your_channel
# Shown in the footer and on the "you're on the list" screen when set.
NEXT_PUBLIC_TELEGRAM_URL=

# ── Supabase (waitlist database) ────────────────────────────────────
# Project URL: Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SECRET key (starts with sb_secret_). Server-only: never prefix it with
# NEXT_PUBLIC_, never commit it. The waitlist is written only by a server
# action, and the table has Row Level Security enabled with no public policies.
# (The legacy SUPABASE_SERVICE_ROLE_KEY name is also accepted.)
SUPABASE_SECRET_KEY=

# Optional. Show "N people already joined" only once the count reaches this.
WAITLIST_COUNT_MIN=50
